{
	"name": "indexcards",
	"version": "1.2.0",
	"description": "Tabroom.com Node API.  This version is the branch for the rewrite.",
	"exports": "./main.js",
	"type": "module",
	"scripts": {
		"start": "NODE_ENV='production' node --use-strict dist/app.js",
		"production": "NODE_ENV='production' node --use-strict dist/app.js",
		"staging": "NODE_ENV='staging' node --use-strict dist/app.js",
		"build": "tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"build:openapi": "tsx scripts/build-openapi.ts",
		"dev": "TZ='UTC' NODE_ENV='development' tsx watch app.js",
		"test": "NODE_ENV='test' VITEST_SEGFAULT_RETRY=3 vitest watch",
		"test:ci": "NODE_ENV='test' vitest --watch false --run",
		"cover": "NODE_ENV='test' vitest --coverage",
		"dev-debug": "node --inspect-brk=9229 app.js",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "prettier --write .",
		"format-check": "prettier --check .",
		"updateTestFile": "NODE_ENV=test tsx scripts/updateTestFile.js"
	},
	"engines": {
		"node": ">= 24.13.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.397.0",
		"@maxmind/geoip2-node": "^3.2.0",
		"@scalar/express-api-reference": "^0.10.1",
		"@speechanddebate/nsda-js-utils": "^1.0.15",
		"@tabroom/types": "1.0.0",
		"axios": "^1.5.1",
		"body-parser": "^2.2.2",
		"cookie-parser": "^1.4.4",
		"cors": "^2.8.5",
		"crypto-js": "^4.0.0",
		"dayjs": "^1.11.13",
		"express": "^5.2.1",
		"express-rate-limit": "^8.3.1",
		"helmet": "^8",
		"html-to-text": "^9.0.5",
		"kysely": "^0.29.6",
		"kysely-mariadb": "^0.1.3",
		"luxon": "^3.7.2",
		"mariadb": "^3.5.4",
		"node-fetch": "^3.3.1",
		"nodemailer": "^7.0.9",
		"sanitize-html": "^2.17.4",
		"ua-parser-js": "^2.0.9",
		"unixcrypt": "^3.0.4",
		"uuid": "^13.0.0",
		"winston": "^3.2.1",
		"zod": "^4.6.5",
		"zod-openapi": "^6.0.2"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.2.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/luxon": "^3.7.1",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^5.0.1",
		"@vitest/ui": "^5.0.1",
		"kysely-codegen": "^0.20.0",
		"openapi3-ts": "^4.6.1",
		"supertest": "^7.1.3",
		"tsx": "^4.19.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
