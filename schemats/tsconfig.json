{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"sourceMap": true,
		"strict": true,
		"useDefineForClassFields": true,
		"checkJs": false,
		"types": [
			"$app/types",
			"node",
			"vitest/globals",
			"@testing-library/jest-dom/vitest"
		]
	},
	"include": [
		"src",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker"
	]
}
