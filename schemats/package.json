{
  "name": "schemats",
  "type": "module",
  "version": "0.5.0",
  "description": "Schemats Frontend Client for Tabroom.com",
  "private": true,
  "engines": {
    "node": ">=24.13.1"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  },
  "scripts": {
    "production": "vite build --mode production && node build/index.js",
    "staging": "vite build --mode staging",
    "build": "vite build --mode production",
    "build-storybook": "storybook build",
    "dev": "vite dev",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --project unit && npm run test:e2e",
    "test:unit": "svelte-kit sync && vitest --project unit",
    "test:ci": "npm run test:ci:unit && npm run test:a11y && npm run test:ci:e2e",
    "test:ci:unit": "svelte-kit sync && vitest --project unit --watch=false --run",
    "test:ci:e2e": "playwright test -c ./config/testing --reporter=github",
    "test:a11y": "svelte-kit sync && vitest --project a11y --run",
    "test:a11y:mobile": "svelte-kit sync && STORYBOOK_VIEWPORT=mobile vitest --project a11y --run",
    "test:a11y:desktop": "svelte-kit sync && STORYBOOK_VIEWPORT=desktop vitest --project a11y --run",
    "test:a11y:multi": "npm run test:a11y:mobile && npm run test:a11y:desktop",
    "test:e2e": "playwright test -c ./config/testing",
    "lint": "oxlint . && npm run lint:svelte",
    "lint:fix": "oxlint --fix . && npm run lint:svelte -- --fix",
    "lint:svelte": "eslint '**/*.svelte'",
    "orval": "orval --config ./config/orval.config.ts",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@lucide/svelte": "^1.20.0",
    "@svar-ui/svelte-filter": "^2.5.0",
    "@svar-ui/svelte-grid": "^2.6.0",
    "@tabroom/types": "1.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.90.7",
    "@tanstack/svelte-query": "^6.0.3",
    "@tanstack/svelte-query-persist-client": "^6.0.5",
    "@tanstack/svelte-table": "^9.0.0-alpha.32",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "tailwindcss": "^4.3.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "~1.63.0",
    "@storybook/addon-a11y": "~10.6.1",
    "@storybook/addon-docs": "~10.6.1",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-vitest": "~10.6.1",
    "@storybook/sveltekit": "~10.6.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.67.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tanstack/svelte-query-devtools": "^6.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "24.13.1",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.1.25",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.12.1",
    "flowbite-svelte": "~1.33.1",
    "globals": "^17.0.0",
    "husky": "^9.0.11",
    "jsdom": "^29.0.1",
    "msw": "^2.13.3",
    "msw-storybook-addon": "^2.0.6",
    "orval": "^8.22.0",
    "playwright": "~1.63.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "sv": "^0.15.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.6",
    "svelte-eslint-parser": "^1.6.0",
    "svelte-preprocess": "^6.0.5",
    "svelte-select-5": "^7.0.4",
    "tsc-alias": "^1.8.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "~4.1.8"
  }
}
