{
	"name": "Tabroom",
	"version": "1.2.0",
	"description": "Tabroom.com",
	"keywords": [
		"speech",
		"debate",
		"congress",
		"tabulation",
		"forensics",
		"utabroom",
		"speechanddebate",
		"NSDA"
	],
	"homepage": "https://www.tabroom.com/about",
	"bugs": {
		"url": "https://github.com/speechanddebate/tabroom/issues"
	},
	"license": "RPL-1.5",
	"contributors": [
		"Chris Palmer <palmer@tabroom.com>",
		"Ryan Tullis <ryan.tullis@speechanddebate.org> (https://speechanddebate.org)"
	],
	"repository": {
		"type": "git",
		"url": "github:speechanddebate/Tabroomv4.git"
	},
	"type": "module",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks && npm run prepare --workspaces --if-present",
		"lint": "oxlint . && npm run lint:svelte --workspace=schemats",
		"lint:fix": "oxlint --fix . && npm run lint:svelte --workspace=schemats -- --fix",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"dev": "npm run dev --workspaces --if-present",
		"test:ci": "npm run test:ci --workspaces --if-present"
	},
	"workspaces": [
		"types",
		"e2e",
		"schemats",
		"indexcards"
	],
	"private": true,
	"devDependencies": {
		"eslint-plugin-storybook": "^10.6.1",
		"oxlint": "^1.80.0"
	},
	"allowScripts": {}
}
