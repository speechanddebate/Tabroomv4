WEB_URL=https://e2e.tabroom.test
INDEXCARDS_HOST=https://api.e2e.tabroom.test
ORIGIN=https://e2e.tabroom.test

# trust the CA nginx generates, for server-side calls to the API
NODE_EXTRA_CA_CERTS=/certs/ca.crt

LOG_LEVEL=info

# the ballot pages are still dev-only
HIDE_DEV_PAGES=false

# user home parts still in development (schemats/src/routes/user/home/features.ts)
HOME_FEATURES=all
