{
	"compilerOptions": {
		// At least indexcards' target: the tests import indexcards factories, so this config typechecks indexcards source
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"allowJs": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["**/*.ts"]
}
